# Copy this file to .env.local for local development, and add the same names in
# Vercel -> Project -> Settings -> Environment Variables for production.

# PostgreSQL connection string (Vercel Storage / Neon: POSTGRES_URL is added automatically)
POSTGRES_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Long random text, used to sign admin login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Admin login (the password is stored hashed; change it here + redeploy to reset it)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-a-long-strong-password

# Vercel Blob (image uploads). Added automatically when you connect a Blob store.
# Leave empty for local development: images are then saved in ./uploads/blogs
BLOB_READ_WRITE_TOKEN=
