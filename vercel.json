{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "admin/**",
          "blog/**",
          "css/**",
          "images/**",
          "js/**",
          "*.html",
          "manifest.webmanifest",
          "robots.txt",
          "sitemap.xml",
          "uploads/**"
        ]
      }
    },
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "X-XSS-Protection": "1; mode=block",
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload"
      },
      "continue": true
    },
    { "src": "/admin/(admin\\.(?:css|js))", "dest": "/admin/$1" },
    { "src": "/admin(?:/(.*))?", "dest": "/server.js" },
    { "src": "/blog(?:/(.*))?", "dest": "/server.js" },
    { "src": "/uploads(?:/(.*))?", "dest": "/server.js" },
    { "src": "/$", "dest": "/index.html" },
    { "src": "/(.+)\\.html", "dest": "/$1.html" },
    { "src": "/([^/]+)", "dest": "/$1.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
